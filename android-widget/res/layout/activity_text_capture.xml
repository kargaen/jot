<?xml version="1.0" encoding="utf-8"?>
<!-- Destination: src-tauri/gen/android/app/src/main/res/layout/activity_text_capture.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Capture"
        android:textColor="#FF655BE8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/capture_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:textSize="16sp"
        android:textColor="#FF171717"
        android:hint="What's on your mind?"
        android:textColorHint="#FF9CA3AF"
        android:background="@drawable/capture_field_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="5"
        android:imeOptions="actionDone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/capture_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#FF6B7280"
            android:textSize="14sp" />

        <Button
            android:id="@+id/capture_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture"
            android:backgroundTint="#FF655BE8"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
